{
  "name": "koryo-tax-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:preview": "NEXT_PUBLIC_NOINDEX=1 opennextjs-cloudflare build && opennextjs-cloudflare preview -e \"\"",
    "cf:deploy": "NEXT_PUBLIC_NOINDEX=1 NEXT_PUBLIC_SITE_URL=https://koryo-tax-web.thetaxplus.workers.dev opennextjs-cloudflare build && opennextjs-cloudflare deploy -e ''",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:deploy:prod": "NEXT_PUBLIC_SITE_URL=https://www.thetaxplus.com opennextjs-cloudflare build && opennextjs-cloudflare deploy -e production"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "leaflet": "1.9.4",
    "marked": "18.0.11",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.126.0"
  }
}
